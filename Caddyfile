{
	admin off
	auto_https off
}

:{$PORT}

root * /srv
encode zstd gzip
file_server

# Frames de scrub : immuables (régénérées sous de nouveaux noms si besoin)
header /frames/* Cache-Control "public, max-age=31536000, immutable"
header /assets/* Cache-Control "public, max-age=604800"
header /css/* Cache-Control "public, max-age=86400"
header /js/* Cache-Control "public, max-age=86400"
